// ==========================================//
// Simple Find Queries - Devices Collection  //
// ==========================================//


// 1. Get all devices
db.devices.find()


// 2. Get one device (first document in collection)
db.devices.findOne()


// 3. Get one device by _id (usando uno que SÍ existe)
db.devices.findOne({ _id: ObjectId("69ea90a127236869037df2f8") })


// 4. Get devices where brand is exactly "LG"
db.devices.find({ brand: "LG" })


// 5. Get devices where status is exactly "Nuevo"
db.devices.find({ status: "active" })


// 6. Get devices where location is exactly "cocina"
db.devices.find({ location: "cocina" })


// 7. Get devices that are online
db.devices.find({ online: true })


// 8. Get devices by brand and status
db.devices.find({ brand: "Samsung", status: "active" })

// ==========================================
// Simple Find Queries - Users Collection
// ==========================================

// 1. Get all users
db.users.find()

// 2. Get one user
db.users.findOne()

// 3. Get one user by _id
db.users.findOne({ _id: ObjectId("69f11041c50d0ccc6367636e") })

// 4. Get users where email is exactly "juan@gmail.com"
db.users.find({ correo_electrónico: "juan38@hotmail.com" })

// 5. Get users where password is exactly "123456"
db.users.find({ password: "123456" })

// 6. Get users where correo_electrónico is exactly "luis0@gmail.com.mx"
db.users.find({ "correo_electrónico": "luis0@gmail.com.mx" })

// 7. Get users that have email field
db.users.find({ email: { $exists: true } })

// 8. Get users by email and password
db.users.find({ email: "test@test.com", password: "123456" })
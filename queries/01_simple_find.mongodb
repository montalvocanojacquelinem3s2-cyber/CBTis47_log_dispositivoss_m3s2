// ==========================================//
// Simple Find Queries - Devices Collection  //
// ==========================================//


// 1. Get all devices
db.devices.find()


// 2. Get one device (first document in collection)
db.devices.findOne()


// 3. Get one device by _id (usando uno que SÍ existe)
db.devices.findOne({ _id: ObjectId("69efc4848a2a3959dbea7b81") })


// 4. Get devices where brand is exactly "LG"
db.devices.find({ brand: "LG" })


// 5. Get devices where status is exactly "Nuevo"
db.devices.find({ status: "Nuevo" })


// 6. Get devices where location is exactly "cocina"
db.devices.find({ location: "cocina" })


// 7. Get devices that are online
db.devices.find({ online: true })


// 8. Get devices by brand and status
db.devices.find({ brand: "Samsung", status: "Nuevo" })


// Projection, Sort & Limit Queries - Devices Collection


// 1. Get all devices showing only brand and location
db.devices.find({}, { _id: 0, brand: 1, location: 1 })


// 2. Get devices showing brand, status and online
db.devices.find({}, { _id: 0, brand: 1, status: 1, online: 1 })


// 3. Get devices sorted by brand (ascending)
db.devices.find().sort({ brand: 1 })


// 4. Get devices sorted by status (descending)
db.devices.find().sort({ status: -1 })


// 5. Get only 5 devices
db.devices.find().limit(5)


// 6. Get 10 devices sorted by brand
db.devices.find().sort({ brand: 1 }).limit(10)


// 7. Get devices with status "Nuevo", show only brand and location, sorted and limited
db.devices.find(
  { status: "Nuevo" },
  { _id: 0, brand: 1, location: 1 }
).sort({ brand: 1 }).limit(5)


// 8. Get devices that are online, show brand and status, sorted by status
db.devices.find(
  { online: true },
  { _id: 0, brand: 1, status: 1 }
).sort({ status: 1 })


// 9. Get devices in "Cocina", show brand and model, limit to 3 results
db.devices.find(
  { location: "Cocina" },
  { _id: 0, brand: 1, model: 1 }
).limit(3)


// 10. Get devices that are NOT "Nuevo", show brand and location, sorted descending and limited
db.devices.find(
  { status: { $ne: "Nuevo" } },
  { _id: 0, brand: 1, location: 1 }
).sort({ brand: -1 }).limit(5)
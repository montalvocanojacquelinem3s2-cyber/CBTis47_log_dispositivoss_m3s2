==============================
// WEEK 11 - UPDATE QUERIES //
==============================

// 1. Update one document: change status to "active" for one HP device
db.devices.updateOne(
  { brand: "HP" },
  { $set: { status: "active" } }
)

// 2. Update many documents: change all "inactive" devices to "active"
db.devices.updateMany(
  { status: "inactive" },
  { $set: { status: "active" } }
)

// 3. Update many: set online to true for all LG devices
db.devices.updateMany(
  { brand: "LG" },
  { $set: { online: true } }
)

// 4. Add new field to all documents
db.devices.updateMany(
  {},
  { $set: { warranty: true } }
)

// 5. Add lastUpdated ONLY to online devices
db.devices.updateMany(
  { online: true },
  { $set: { lastUpdated: new Date() } }
)

// 6. Update using condition (battery level less than 20)
db.devices.updateMany(
  { batteryLevel: { $lt: 20 } },
  { $set: { status: "maintenance" } }
)

// 7. Remove field "status" ONLY from LG devices
db.devices.updateMany(
  { brand: "LG" },
  { $unset: { status: "" } }
)

=====================================
// WEEK 11 - UPDATE QUERIES (USERS)//
=====================================

// 1. Update one document: change password for one user
db.users.updateOne(
  { email: "test@test.com" },
  { $set: { password: "newpass123" } }
)

// 2. Update many documents: change same password
db.users.updateMany(
  { password: "123456" },
  { $set: { password: "updated123" } }
)

// 3. Update many: add active true for Gmail users
db.users.updateMany(
  { email: /gmail/ },
  { $set: { active: true } }
)

// 4. Add new field to all documents
db.users.updateMany(
  {},
  { $set: { verified: false } }
)

// 5. Add lastUpdated only to users with email
db.users.updateMany(
  { email: { $exists: true } },
  { $set: { lastUpdated: new Date() } }
)

// 6. Update using condition
db.users.updateMany(
  { password: { $exists: true } },
  { $set: { status: "updated" } }
)

// 7. Remove field "password" from one user
db.users.updateMany(
  { email: "juan@gmail.com" },
  { $unset: { password: "" } }
)